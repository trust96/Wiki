model User {
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  deletedAt       DateTime?
  emailVerifiedAt DateTime? @map("verifiedAt")
  bannedAt        DateTime?

  id        String  @id @default(uuid())
  email     String  @unique
  password  String
  firstName String? @map("name")
  lastName  String? @map("surname")
  status    Int?
  role      Int?

  // Legacy registration remains available until the v1 cutover.
  emailKey        String?   @unique
  username        String?
  usernameKey     String?   @unique
  termsVersion    String?
  termsAcceptedAt DateTime?

  artistName     String?
  artistNameKey  String? @unique
  bio            String  @default("")
  avatarUrl      String?
  isOnboarded    Boolean @default(false)
  sessionVersion Int     @default(0)

  authTokens AuthToken[]
}

# Local Docker Compose Postgres (from host).
# Inside Compose services, hostname is `postgres` (set by docker-compose.yml).
DATABASE_URL="postgresql://wiki:wiki@localhost:5432/wiki?schema=public"

# Redis: use localhost from the host; use redis://redis:6379 inside Compose.
REDIS_URL="redis://127.0.0.1:6379"

HOST="localhost"
PORT="5000"
TOKEN_SECRET="change-me"
# Production requires an explicit random session secret of at least 32 characters.
# Comma-separated exact app/site origins; HTTPS is required in production.
CORS_ORIGIN="http://localhost:3000"
# Set to the real published version before enabling v1 registration.
# TERMS_VERSION=
# Trust only the proxy IPs/CIDRs that connect directly to the API.
TRUSTED_PROXIES=""

# Required for registration, resend, recovery, and the durable mail worker.
# Generate MAIL_ENCRYPTION_KEY with: openssl rand -hex 32
# Keep the key stable while any mail remains queued.
MAIL_ENCRYPTION_KEY=""
MAIL_ENCRYPTION_KEY_ID="v1"
MAIL_FROM=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
# Real HTTPS frontend pages must read fragment tokens, remove them from history,
# and submit tokens to the API in JSON. No tokens in URL paths/query strings.
FRONTEND_VERIFICATION_URL=""
FRONTEND_RESET_URL=""
PASSWORD_SALT="10"
TOKEN_NAME="wiki-admin-token"
APP_NAME="WikiDance"

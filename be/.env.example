# Local Docker Compose Postgres (from host).
# Inside Compose services, hostname is `postgres` (set by docker-compose.yml).
DATABASE_URL="postgresql://wiki:wiki@localhost:5432/wiki?schema=public"

# Redis: use localhost from the host; use redis://redis:6379 inside Compose.
REDIS_URL="redis://127.0.0.1:6379"

HOST="localhost"
PORT="5000"
TOKEN_SECRET="change-me"
PASSWORD_SALT="10"
TOKEN_NAME="wiki-admin-token"
APP_NAME="WikiDance"
CORS_ORIGIN="http://localhost:3000"

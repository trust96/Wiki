model User {
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?
  verifiedAt DateTime?
  bannedAt DateTime?

  id       String  @id @default(uuid())
  email    String  @unique
  password String
  name     String?
  surname  String?
  status   Int?
  role     Int?
}
